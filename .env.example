# Server Configuration
# Next.js will use this port if set, otherwise defaults to 3000
# To use: Set this value and restart the dev server
PORT=3000

# JW Player License Key (REQUIRED)
# Get your license key from: https://www.jwplayer.com/
# This is required for the video player to work
JW_PLAYER_KEY=your_jwplayer_license_key_here

# Anime Source API Configuration
# These have working defaults and usually don't need to be changed
SOURCE_ORIGIN=
SOURCE_REFERER=

# API Configuration
# Set to 'production' to enable DevTools protection
NODE_ENV=development

# Optional: API Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60000
